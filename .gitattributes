# Forzar terminaciones LF en scripts y archivos sensibles al formato,
# evitando el bug de CRLF (Windows) que rompia entrypoint.sh dentro del contenedor.
*.sh           text eol=lf
*.py           text eol=lf
Dockerfile     text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.conf         text eol=lf
*.json         text eol=lf
manage.py      text eol=lf
entrypoint.sh  text eol=lf
